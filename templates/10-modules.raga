// Modules: one file uses the names of another file
// import gives a file as a value, export lists the names that the file shares
//
// A program can be one file or many. A file is a module: every name declared at its top level belongs to that file
// and is private to it, unless the file exports it. This template uses functions (04-functions), structs
// (05-structs-enums-unions) and errors (06-errors).
// The built-in names (print, String, List, ...) are always there and need no import.


// ============================================================
// 1. EXPORT: THE NAMES A FILE SHARES
// ============================================================

// A file lists the names that others may use in one export call, at the end of the file. export takes an Array block of
// names, written without parentheses like every call whose last argument is a block (04-functions), and import is a
// function whose argument is a path.
// Functions, constants and types can be exported. A name that is not listed stays private to the file.
//
//   ---- the file ./geometry/shapes.raga ----
//   const pi = 3.14159
//   const Point = struct {
//       f64 x
//       f64 y
//   }
//   const circle_area = function(f64 radius) f64 {
//       return(pi * radius * radius)
//   }
//   const square = function(f64 side) f64 {      // private: not in the export call
//       return(side * side)
//   }
//   export { pi, Point, circle_area }
//   ----------------------------------------
//
// Rules:
//   - There is at most one export call in a file, and it is the last statement of the file.
//   - The block holds bare names, not values: export { pi } shares the name pi, it does not pass 3.14159 on.
//   - Each name in it is declared above it, at the top level of the file. Exporting a name that does not exist is an error.
//   - A name is listed once.
// export { missing }                          // ERROR: missing is not declared in this file
// export(pi)                               // ERROR: write export { pi }, export takes a block of names


// ============================================================
// 2. IMPORT: A FILE AS A VALUE
// ============================================================

// import(path) gives a Module: a value that holds the exported names of the file at that path.
// The path is a String, written from the folder of the file that imports it, without the .raga ending.
// A name of the module is reached with a dot, like a field of a struct.
const shapes = import("./geometry/shapes")

const area = shapes.circle_area(2.0)           // 12.56636
const center = shapes.Point(x = 0.0, y = 0.0)  // a type of the module is used with its module name in front
shapes.Point origin = shapes.Point(x = 1.0, y = 1.0)
const points = List<shapes.Point>()            // also inside the angle brackets
const radius_pi = shapes.pi                    // 3.14159

// Rules:
//   - import is a function, and the module is an ordinary const: choose any name for it, it does not have to match the file.
//   - A path starting with ./ is from the folder of this file, ../ goes up one folder.
//   - Only exported names are there. A private name, or a name that does not exist, is an error:
// const bad_square = shapes.square(2.0)    // ERROR: square is not exported by ./geometry/shapes
// const bad_path = import("./missing")   // ERROR: there is no file ./missing.raga
//   - A module is read-only. An exported name cannot be assigned from outside:
// shapes.pi = 3.0                          // ERROR: pi belongs to the file that exports it
//   - Two imports of the same file give the same Module, and the file runs only once:
const again = import("./geometry/shapes")
const same_module = shapes == again            // true: one module, shared, like every non-primitive value
//   - import is declared at the top level, like any name, and above its first use.


// ============================================================
// 3. WHEN A FILE RUNS
// ============================================================

// The code at the top level of an imported file runs once, the first time it is imported, before the next line
// of the importing file. A file that imports another waits for it.
// There is no main function: the program is the file that is run, and its top-level code runs from the first line to the last.
// Modules cannot import each other in a circle: if a.raga imports b.raga, b.raga cannot import a.raga, directly or through
// a third file. That is a compile error, the same way two functions cannot call each other (04-functions).
//   ---- a.raga ----          ---- b.raga ----
//   const b = import("./b")     const a = import("./a")     // ERROR: a and b import each other

// libraries/startup.raga prints a line at its top level and shares one name. Importing it shows the order:
print("before the import")
const startup = import("startup")               // the top-level code of startup runs here: it prints "startup is running"
print("after the import")
const startup_again = import("startup")         // already loaded: the code does not run a second time
const startup_ready = startup.ready             // true
const startup_same = startup == startup_again   // true: one module, shared
// The program prints, in this order:
//   before the import
//   startup is running
//   after the import
// A file that is imported and then imported again prints once, because its code ran the first time and the module was kept.


// ============================================================
// 4. TAKING ONE NAME, RENAMING AND EXPORTING AGAIN
// ============================================================

// A module has no special syntax for any of this. Its names are values, functions and types, so an ordinary const gives
// one of them a name of your own. That is enough to take only the names you want, to rename them, and to share them again.

// Taking one name out of a module: a const that holds it.
const just_pi = shapes.pi                      // a value
const area_of = shapes.circle_area             // a function: a bare name is the function itself, call it with area_of(1.0)
const Vec2 = shapes.Point                      // a type: a second name for it, like any alias (05-structs-enums-unions)
Vec2 corner = Vec2(x = 1.0, y = 2.0)
const corner_area = area_of(corner.x)          // 3.14159

// Renaming and exporting again: a file that imports another and shares part of it under its own names.
//   ---- ./geometry/api.raga ----
//   const shapes = import("./shapes")
//   const area_of_circle = shapes.circle_area    // a new name for an imported function
//   const Pt = shapes.Point                      // a new name for an imported type
//   const pi = shapes.pi                         // taken as it is
//   const square = function(f64 side) f64 {      // and a name of its own
//       return(side * side)
//   }
//   export { area_of_circle, Pt, pi, square }       // the file shares what it took and what it declared
//   ----------------------------------------
// A file that imports api sees area_of_circle, Pt, pi and square. It does not see shapes: a name that is not in the
// export call is private, also when it is a module.

// Rules:
//   - Taking a name copies nothing: a const that holds a function, a type or a non-primitive value refers to the same one.
//   - A const that holds a primitive of the module, such as pi, holds its value.
//   - The new name follows the naming style of what it names: types are Capitalized, values and functions are lower_snake_case.


// ============================================================
// 5. IMPORTING A LIBRARY BY NAME
// ============================================================

// A path starts with ./ or ../ and names a file. A name with no path names a library, and the language looks for it in
// three places, in this order. The first one that has it wins.
//   1. the project file raga.project, if there is one: a line  name = "path"  gives the name a file
//   2. the libraries folder of the project: libraries/name.raga, or libraries/name/name.raga
//   3. the standard location that comes with the language: libraries written in Raga that are installed with it, such as test
//      (the library of section 6). A library of the same name in the project is found first, so a project can replace one.
// The project is the nearest folder above the importing file that has a raga.project file or a libraries folder.
//
//   ---- raga.project ----                               ---- libraries/greeting.raga ----
//   // an optional file                                  const hello = function(String name) String {
//   shapes_lib = "./geometry/shapes"                         return(String.format("hello %s", name))
//                                                        }
//                                                        export { hello }
const greeting = import("greeting")             // found in libraries/greeting.raga
const hello_ann = greeting.hello("ann")         // "hello ann"
const shapes_lib = import("shapes_lib")         // found through raga.project: ./geometry/shapes
const lib_area = shapes_lib.circle_area(1.0)

// Rules:
//   - import is resolved while the program is built, so its argument is a path or a name written in the code, as a String
//     literal. A path in a variable, or one that is worked out, is an error: a program does not import while it runs.
//   - A library is an ordinary module: the same export call, the same read-only names, loaded once.
//   - raga.project is a list of lines  name = "path". The path is from the folder of the project file, without .raga.
//     A line that starts with // is a comment.
//   - A name that none of the three places has is a compile error that says where it looked.
//   - The file comes first so that a project can replace a library or give a long path a short name.
// const bad = import("missing")               // ERROR: there is no library missing: looked in raga.project, the libraries folder
//                                             //        and the standard location
// const name = "greeting"
// const bad = import(name)                    // ERROR: import takes a path or a library name written in the code, as a String literal


// ============================================================
// 6. A LIBRARY IN USE: TESTS
// ============================================================

// Tests need no special feature. A test library is written in Raga with the callbacks and trailing blocks of 04-functions:
// describe groups tests, it runs one test, and check fails a test by throwing an Error (06-errors). The library is
// libraries/test.raga next to this file, and it is not built in.
//   ---- libraries/test.raga (the important parts) ----
//   const describe = function(String name, Function body) { print(name)  body() }
//   const it = function(String name, Function body) {
//       try { body()  ... counts it as passed } catch |e| { ... counts it as failed and prints e.message }
//   }
//   const check = function(bool condition) { if (!condition) { throw(Error(message = "check failed", code = 1)) } }
//   export { describe, it, check, summary }
const t = import("test")

t.describe("circle_area") {
    t.it("is zero for a radius of zero") {
        t.check(shapes.circle_area(0.0) == 0.0)
    }
    t.it("grows with the radius") {
        t.check(shapes.circle_area(2.0) > shapes.circle_area(1.0))
    }
    t.it("is not negative") {
        t.check(shapes.circle_area(1.0) < 0.0)         // this one fails and is reported, the other tests still run
    }
}
const test_report = t.summary()                        // "2 passed, 1 failed"

// Rules:
//   - describe and it are ordinary functions whose last parameter is a callback, so each one takes a trailing block and the
//     blocks nest. They are called through the module name, t.describe(...), like any member of a module.
//   - A failing check throws, it catches it and goes on, so one failing test does not stop the others.
//   - The library keeps its counts in a const struct, which the functions of the file change: the module itself is read-only
//     from outside, and tally is not exported.
