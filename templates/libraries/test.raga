// A small test library, written in Raga. 10-modules.raga imports it with import("test").
// A test is a block. describe groups tests, it runs one, and check fails the test by throwing an Error.

const Tally = struct {
    i32 passed
    i32 failed
}
const tally = Tally(passed = 0, failed = 0)

const describe = function(String name, function() body) {
    print(name)
    body()
}

const it = function(String name, function() body) {
    try {
        body()
        tally.passed = tally.passed + 1
        print(String.format("  ok   %s", name))
    } catch |e| {
        tally.failed = tally.failed + 1
        print(String.format("  FAIL %s: %s", name, e.message))
    }
}

const check = function(bool condition) {
    if (!condition) { throw(Error(message = "check failed", code = 1)) }
}

const summary = function() String {
    return(String.format("%d passed, %d failed", tally.passed, tally.failed))
}

export { describe, it, check, summary }
